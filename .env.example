# Copy to .env and fill in. Never commit .env.

# Organization-scoped token. Optional: without it the service degrades to "unavailable"
# and the score is calculated without the verification component.
CROMA_API_KEY=

CROMA_BASE_URL=https://api.croma.run
CROMA_ORGANIZATION_ID=

# Seconds the API is asked to wait inline before returning an async job (max 55).
CROMA_WAIT_SECONDS=55

# Hard ceiling on a single request. Nothing may hang the score calculation.
CROMA_TIMEOUT_MS=60000

# Dot path to the RFC inside the SIEM establishment detail response.
SIEM_DETAIL_RFC_FIELD=establishment.rfc

# How long a verification result is reused before querying again.
BUSINESS_VERIFICATION_CACHE_TTL_MS=604800000

# Detail lookups allowed per verification. Each one costs a request against the daily quota.
BUSINESS_VERIFICATION_MAX_DETAIL_LOOKUPS=1

# Comma-separated. Empty means the radar reports nothing.
# Matched on word boundaries and without accents, against the title a source publishes.
# These are phrases taken from the live rulebook catalogue, not invented topics.
REGULATORY_RADAR_KEYWORDS=ahorro y credito popular,ahorro y prestamo,informacion crediticia,uniones de credito,tecnologia financiera,instituciones de credito,sociedades financieras de objeto multiple,credito garantizado,servicios financieros,medios de disposicion,sistemas de pagos,tramites burocraticos,fondos de inversion,procedencia ilicita

# Gazette dates scanned per run. Each date costs one request.
REGULATORY_RADAR_SCAN_DAYS=7
REGULATORY_RADAR_CACHE_TTL_MS=86400000
REGULATORY_RADAR_MAX_ALERTS=20
