{
  "name": "creva-score",
  "version": "0.1.0",
  "private": true,
  "description": "Business verification signal for the Creva score, sourced from Mexican government records.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:fuzz": "jest --selectProjects fuzz",
    "test:invariant": "jest --selectProjects invariant",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "fast-check": "^3.22.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
